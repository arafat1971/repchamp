{
  "name": "repchamp",
  "version": "2.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-firebase/app": "^23.4.1",
    "@react-native-firebase/app-check": "^23.8.8",
    "@react-native-firebase/auth": "^23.4.1",
    "@react-native-firebase/firestore": "^23.4.1",
    "@react-native-firebase/storage": "^23.4.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.7",
    "expo-audio": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.6",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.5",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-notifications": "~57.0.6",
    "expo-observe": "~57.0.8",
    "expo-router": "~57.0.7",
    "expo-sharing": "~57.0.7",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.10",
    "expo-video": "~57.0.2",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-image": "^0.15.1",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-purchases": "^10.4.4",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-vision-camera": "^5.1.1",
    "react-native-vision-camera-worklets": "^5.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "fetch-model": "bash scripts/fetch-model.sh",
    "generate-sounds": "node scripts/generate-sounds.js",
    "postinstall": "node scripts/generate-sounds.js && (test -f assets/models/movenet.tflite || bash scripts/fetch-model.sh || echo '[repchamp] WARNING: pose model not fetched — run: npm run fetch-model (required before building the app)')",
    "eas-build-pre-install": "bash scripts/fetch-model.sh",
    "trace-reps": "bash scripts/trace-reps.sh"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-app-metrics",
        "expo-observe"
      ]
    }
  }
}
