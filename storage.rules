rules_version = '2';

// RepChamp Cloud Storage rules — avatar images and duel/together action shots.
// Writes: owner + size/type caps (JPEG/PNG/WebP). Reads: signed-in athletes.

service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024   // 2 MB
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // One action-shot photo per seat per duel — the athlete's own captured
    // frame from a versus/together set, shown to their opponent/partner on
    // the shared result card. Path shape pins the seat; the write is further
    // scoped to whichever uid actually holds that seat on the live duel doc,
    // so a guest can never overwrite the host's photo or vice versa.
    match /duelPhotos/{duelId}/{seat}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && seat in ['host', 'guest']
        && request.auth.uid == firestore.get(/databases/(default)/documents/duels/$(duelId)).data[seat].uid
        && request.resource.size < 3 * 1024 * 1024   // 3 MB
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null
        && seat in ['host', 'guest']
        && request.auth.uid == firestore.get(/databases/(default)/documents/duels/$(duelId)).data[seat].uid;
    }
  }
}
