rules_version = '2';

// RepChamp Cloud Storage rules — avatar images only.
// Writes: owner + size/type caps (JPEG/PNG/WebP). Reads: signed-in athletes.

service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024   // 2 MB
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
