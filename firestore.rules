rules_version = '2';

// RepChamp Firestore security rules.
//
// Model:
//   users/{uid}                      – public profile slice (no push tokens)
//   users/{uid}/private/{doc}        – owner-only secrets (push token)
//   users/{uid}/friends/{friendUid}  – owner-managed friend edges
//   leaderboard/{uid}                – flat weekly-XP row
//   duels/{duelId}                   – live 1v1 duel (own-seat writes only)
//   couples/{coupleId}               – couple bond; doc id is the pair code
//   matchmaking/{uid}                – open-queue ticket
//
// Principles: owner-scoped writes; cross-user paths are narrowly capability-
// based (invite code / duel join / matchmaking claim). Competitive state
// (duel seats, couple member reps) may only be mutated by that athlete.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAuthed() {
      return request.auth != null;
    }

    match /users/{uid} {
      // Public profile lookup (username / add-friend). Push tokens live under
      // /private — never on this document.
      allow read: if isAuthed();

      function isProfileWrite() {
        return request.resource.data.uid == uid
          && request.resource.data.totalXp is number
          && request.resource.data.totalXp >= 0
          && request.resource.data.totalXp <= 100000000
          && (!('username' in request.resource.data)
              || (request.resource.data.username is string
                  && request.resource.data.username.size() >= 3
                  && request.resource.data.username.size() <= 20))
          && (!('displayName' in request.resource.data)
              || (request.resource.data.displayName is string
                  && request.resource.data.displayName.size() <= 40))
          && (!('avatarUrl' in request.resource.data)
              || request.resource.data.avatarUrl == null
              || (request.resource.data.avatarUrl is string
                  && request.resource.data.avatarUrl.size() <= 500
                  && (
                    request.resource.data.avatarUrl.size() == 0
                    || request.resource.data.avatarUrl.matches('https://.*')
                  )))
          && (!('lastActiveAt' in request.resource.data)
              || request.resource.data.lastActiveAt is number)
          && (!('createdAt' in request.resource.data)
              || request.resource.data.createdAt is number)
          // Push tokens must not be stored on the world-readable profile.
          && !('expoPushToken' in request.resource.data);
      }

      // Heartbeat-only updates (Friends "Active now") without rewriting XP.
      function isPresenceOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastActiveAt'])
          && request.resource.data.lastActiveAt is number;
      }

      // One-time migration: delete a legacy world-readable push token field.
      function isLegacyPushStrip() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['expoPushToken'])
          && !('expoPushToken' in request.resource.data);
      }

      // createdAt is stamped once — never rewrite it to game "New on RepChamp".
      function createdAtPinned() {
        return !('createdAt' in resource.data)
          || request.resource.data.createdAt == resource.data.createdAt;
      }

      allow create: if isOwner(uid) && isProfileWrite();
      allow update: if isOwner(uid) && (
        isPresenceOnly()
        || isLegacyPushStrip()
        || (isProfileWrite() && createdAtPinned())
      );
      allow delete: if isOwner(uid);

      // Owner-only secrets (Expo push token). Partners receive the token via the
      // couple member object the owner writes while paired — never via this path.
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /friends/{friendUid} {
        // Only the list owner may add/remove. Reciprocal friendship requires the
        // other athlete to add you back (no force-inject onto someone else's list).
        allow read, create, update, delete: if isOwner(uid);
      }

      // Owner-managed block list — used to hide peers and refuse invites.
      match /blocks/{blockedUid} {
        allow read, create, update, delete: if isOwner(uid);
      }
    }

    // User reports — create-only for the reporter; no client list/read (review
    // happens in console / support). Caps keep spam payloads small.
    match /reports/{reportId} {
      allow create: if isAuthed()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 40
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string
                && request.resource.data.note.size() <= 400))
        && (!('context' in request.resource.data)
            || (request.resource.data.context is string
                && request.resource.data.context.size() <= 80));
      allow read, update, delete: if false;
    }

    match /duels/{duelId} {
      function isPlayer() {
        return isAuthed() &&
          (request.auth.uid == resource.data.hostUid ||
           request.auth.uid == resource.data.guestUid);
      }

      function isTarget() {
        return isAuthed() && request.auth.uid == resource.data.targetUid;
      }

      allow read: if isPlayer() || isTarget();

      // Host opens a pending invite, or a matchmaking seeker mints an active
      // duel where they are the guest and both seats start at zero reps.
      allow create: if isAuthed()
        && (
          (request.resource.data.hostUid == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.guestUid == null
            && request.resource.data.host.uid == request.auth.uid
            && request.resource.data.host.reps == 0)
          ||
          (request.resource.data.status == 'active'
            && request.resource.data.targetUid == null
            && request.resource.data.guestUid == request.auth.uid
            && request.resource.data.hostUid is string
            && request.resource.data.hostUid != request.auth.uid
            && request.resource.data.host.uid == request.resource.data.hostUid
            && request.resource.data.guest.uid == request.auth.uid
            && request.resource.data.host.reps == 0
            && request.resource.data.guest.reps == 0)
        );

      function isJoin() {
        return resource.data.status == 'pending'
          && resource.data.guestUid == null
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.status == 'active'
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.host.uid == resource.data.host.uid
          && request.resource.data.guest.uid == request.auth.uid
          && request.resource.data.guest.reps == 0
          && (resource.data.targetUid == null || resource.data.targetUid == request.auth.uid)
          // Host seat must not be rewritten on join.
          && request.resource.data.host.reps == resource.data.host.reps
          && request.resource.data.host.done == resource.data.host.done;
      }

      // Live / finish writes may only touch the caller's own seat map, plus
      // status/winnerUid when settling. The opponent's seat is frozen.
      function hostSeatWrite() {
        return request.auth.uid == resource.data.hostUid
          && request.resource.data.host.uid == resource.data.host.uid
          && request.resource.data.guestUid == resource.data.guestUid
          && request.resource.data.hostUid == resource.data.hostUid
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['host'])
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['host', 'status', 'winnerUid'])
          )
          && (resource.data.guest == null
              || request.resource.data.guest == resource.data.guest)
          && seatRepsFair(resource.data.host, request.resource.data.host);
      }

      function guestSeatWrite() {
        return request.auth.uid == resource.data.guestUid
          && resource.data.guest != null
          && request.resource.data.guest.uid == resource.data.guest.uid
          && request.resource.data.guestUid == resource.data.guestUid
          && request.resource.data.hostUid == resource.data.hostUid
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest'])
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['guest', 'status', 'winnerUid'])
          )
          && request.resource.data.host == resource.data.host
          && seatRepsFair(resource.data.guest, request.resource.data.guest);
      }

      // Anti-cheat: reps non-decreasing + capped. Live ticks limited to +8;
      // finishing (`done: true`) may write the final score in one shot so a
      // missed live sync cannot brick settlement.
      function seatRepsFair(before, after) {
        return after.reps is number
          && after.reps >= 0
          && after.reps <= 500
          && after.reps >= before.reps
          && (
            after.done == true
              || after.reps <= before.reps + 8
          )
          && (!('formScore' in after)
              || (after.formScore is number
                  && after.formScore >= 0
                  && after.formScore <= 100));
      }

      function isLiveUpdate() {
        return isPlayer() && (hostSeatWrite() || guestSeatWrite());
      }

      allow update: if isAuthed() && (isJoin() || isLiveUpdate());

      allow delete: if isAuthed() && (
        resource.data.hostUid == request.auth.uid
        || (resource.data.targetUid == request.auth.uid
            && resource.data.status == 'pending'
            && resource.data.guestUid == null)
      );
    }

    match /couples/{coupleId} {
      function isMember() {
        return isAuthed() && request.auth.uid in resource.data.memberUids;
      }

      // Get: members always; pending invites readable by code so a partner can join.
      // List: only docs where the caller is already a member (my-couples query).
      allow get: if isAuthed() && (
        request.auth.uid in resource.data.memberUids
        || resource.data.pending == true
      );
      allow list: if isAuthed() && request.auth.uid in resource.data.memberUids;

      function memberZeroed(m) {
        return m.totalReps == 0
          && m.trainedDays.size() == 0
          && m.uid is string
          && m.displayName is string;
      }

      // Creator seats only themselves at zero reps.
      allow create: if isAuthed()
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.pending == true
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0].uid == request.auth.uid
        && memberZeroed(request.resource.data.members[0]);

      // Joiner appends themselves at zero; the existing member's stats are frozen.
      function isJoin() {
        return isAuthed()
          && resource.data.memberUids.size() == 1
          && request.resource.data.memberUids
               == resource.data.memberUids.concat([request.auth.uid])
          && request.resource.data.pending == false
          && request.resource.data.members.size() == 2
          && request.resource.data.members[0] == resource.data.members[0]
          && request.resource.data.members[1].uid == request.auth.uid
          && memberZeroed(request.resource.data.members[1]);
      }

      function memberUidsPinned() {
        return request.resource.data.members.size() == resource.data.members.size()
          && request.resource.data.members[0].uid == resource.data.members[0].uid
          && (resource.data.members.size() < 2
              || request.resource.data.members[1].uid == resource.data.members[1].uid);
      }

      function repsInSaneRange() {
        return request.resource.data.members[0].totalReps is number
          && request.resource.data.members[0].totalReps >= 0
          && request.resource.data.members[0].totalReps <= 10000000
          && (resource.data.members.size() < 2
              || (request.resource.data.members[1].totalReps is number
                  && request.resource.data.members[1].totalReps >= 0
                  && request.resource.data.members[1].totalReps <= 10000000));
      }

      // Each athlete may only mutate their own member slice (reps / days / push).
      // The partner's entire member map stays frozen (including their push token).
      function onlyOwnMemberStatsChanged() {
        return (
          (resource.data.members.size() == 1
            && request.auth.uid == resource.data.members[0].uid
            && request.resource.data.members[0].uid == resource.data.members[0].uid)
          ||
          (resource.data.members.size() == 2
            && (
              (request.auth.uid == resource.data.members[0].uid
                && request.resource.data.members[1] == resource.data.members[1])
              ||
              (request.auth.uid == resource.data.members[1].uid
                && request.resource.data.members[0] == resource.data.members[0])
            ))
        );
      }

      function isNudgeOnly() {
        return isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nudge']);
      }

      function isMemberUpdate() {
        return isMember()
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members', 'nudge', 'pending', 'pairedAt'])
          && memberUidsPinned()
          && repsInSaneRange()
          && onlyOwnMemberStatsChanged();
      }

      allow update: if isJoin() || isNudgeOnly() || isMemberUpdate();
      allow delete: if isMember();
    }

    match /matchmaking/{ticketUid} {
      allow read: if isAuthed();
      allow create, update, delete: if isOwner(ticketUid);

      allow update: if isAuthed()
        && request.auth.uid != ticketUid
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'matched'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.level == resource.data.level
        && request.resource.data.duelId is string
        && exists(/databases/$(database)/documents/duels/$(request.resource.data.duelId))
        && get(/databases/$(database)/documents/duels/$(request.resource.data.duelId)).data.hostUid
             == resource.data.uid
        && get(/databases/$(database)/documents/duels/$(request.resource.data.duelId)).data.guestUid
             == request.auth.uid
        && get(/databases/$(database)/documents/duels/$(request.resource.data.duelId)).data.status
             == 'active';
    }

    match /leaderboard/{uid} {
      allow read: if isAuthed();
      function validScoreRow() {
        return request.resource.data.uid == uid
          && request.resource.data.weeklyXp is number
          && request.resource.data.weeklyXp >= 0
          && request.resource.data.weeklyXp <= 50000
          && request.resource.data.totalXp is number
          && request.resource.data.totalXp >= 0
          && request.resource.data.totalXp <= 100000000
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 40;
      }
      allow create, update: if isOwner(uid) && validScoreRow();
      allow delete: if isOwner(uid);
    }
  }
}
