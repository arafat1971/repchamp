{
  "expo": {
    "name": "Fitness Duel: RepChamp",
    "slug": "repchamp",
    "owner": "aro765",
    "version": "2.0.0",
    "scheme": "repchamp",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "gg.repchamp.app",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "RepChamp uses the camera to count your reps and check your form. Video is processed entirely on your device and is never uploaded or recorded.",
        "NSPhotoLibraryUsageDescription": "Pick a profile photo for your RepChamp account.",
        "NSPhotoLibraryAddUsageDescription": "Save your duel result cards to your photo library.",
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "gg.repchamp.app",
      "versionCode": 10,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#8AC53E",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "backgroundColor": "#F6F7F5",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "repchamp.web.app",
              "pathPrefix": "/couple/join"
            },
            {
              "scheme": "https",
              "host": "repchamp.web.app",
              "pathPrefix": "/@"
            },
            {
              "scheme": "https",
              "host": "repchamp.web.app",
              "pathPrefix": "/duel/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/app-check",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.613733102264-dujerefs3d7lv35i4ea1m5f2jqiqv9s4"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          },
          "android": {
            "minSdkVersion": 26,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableCoreMLDelegate": true,
          "enableAndroidGpuLibraries": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a profile photo for your RepChamp account."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "RepChamp uses the camera to scan your partner's pairing QR code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8AC53E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "@sentry/react-native/expo",
      "expo-sharing",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d6be255f-fe5b-40f6-a206-f6e2810f9295"
