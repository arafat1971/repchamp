rules_version = '2';

// RepChamp Firestore security rules.
//
// Model:
//   users/{uid}                      – public profile slice (no push tokens)
//   users/{uid}/private/{doc}        – owner-only secrets (push token)
//   users/{uid}/friends/{friendUid}  – owner-managed friend edges
//   leaderboard/{uid}                – flat weekly-XP row
//   duels/{duelId}                   – live 1v1 duel (own-seat writes only)
//   couples/{coupleId}               – couple bond; doc id is the pair code
//   matchmaking/{uid}                – open-queue ticket
//
// Principles: owner-scoped writes; cross-user paths are narrowly capability-
// based (invite code / duel join / matchmaking claim). Competitive state
// (duel seats, couple member reps) may only be mutated by that athlete.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAuthed() {
      return request.auth != null;
    }

    // An avatar field that is absent, null, or a string no larger than an
    // inlined avatar (MAX_AVATAR_DATA_URI_BYTES in domain/safety.ts). Size
    // only — the format is the profile rule's business.
    function smallUrl(m, key) {
      return m.get(key, null) == null
        || (m[key] is string && m[key].size() <= 65536);
    }

    match /users/{uid} {
      // Public profile lookup (username / add-friend). Push tokens live under
      // /private — never on this document.
      allow get: if isAuthed();

      // Listing is capped, not removed: username lookup and "recent athletes"
      // are real features and both run with a small `limit`. A query with no
      // limit leaves `request.query.limit` unset, which errors and so denies,
      // meaning a signed-in (even anonymous) client can no longer dump the
      // whole collection in one call. Paging through it is still possible;
      // the cap makes it slow and visible in App Check metrics, not
      // impossible. Keep this >= the largest limit in leaderboardService.ts
      // (fetchRecentAthletes asks for limit + 8, default 20).
      allow list: if isAuthed() && request.query.limit <= 20;

      function isProfileWrite() {
        return request.resource.data.uid == uid
          && request.resource.data.totalXp is number
          && request.resource.data.totalXp >= 0
          && request.resource.data.totalXp <= 100000000
          && (!('username' in request.resource.data)
              || (request.resource.data.username is string
                  && request.resource.data.username.size() >= 3
                  && request.resource.data.username.size() <= 20))
          && (!('displayName' in request.resource.data)
              || (request.resource.data.displayName is string
                  && request.resource.data.displayName.size() <= 40))
          // Avatars are inlined as base64 data URIs, not URLs: Storage needs
          // the paid Blaze plan, so `uploadAvatar` downscales to 192x192 and
          // writes the bytes onto this document instead. This rule still
          // demanded `https://` under 500 bytes, which every real avatar
          // failed — so photos stayed local and never reached other devices.
          //
          // The ceiling matches MAX_AVATAR_DATA_URI_BYTES in domain/safety.ts.
          // It has to stay well under Firestore's 1 MiB per-document limit,
          // because this field shares the document with XP and personal bests
          // and an oversized write would fail all of it, not just the photo.
          && (!('avatarUrl' in request.resource.data)
              || request.resource.data.avatarUrl == null
              || (request.resource.data.avatarUrl is string
                  && request.resource.data.avatarUrl.size() <= 65536
                  && (
                    request.resource.data.avatarUrl.size() == 0
                    || request.resource.data.avatarUrl.matches('https://.*')
                    || request.resource.data.avatarUrl.matches('data:image/[a-z]+;base64,.*')
                  )))
          && (!('lastActiveAt' in request.resource.data)
              || request.resource.data.lastActiveAt is number)
          && (!('createdAt' in request.resource.data)
              || request.resource.data.createdAt is number)
          // Push tokens must not be stored on the world-readable profile.
          && !('expoPushToken' in request.resource.data);
      }

      // Heartbeat-only updates (Friends "Active now") without rewriting XP.
      function isPresenceOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastActiveAt'])
          && request.resource.data.lastActiveAt is number;
      }

      // One-time migration: delete a legacy world-readable push token field.
      function isLegacyPushStrip() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['expoPushToken'])
          && !('expoPushToken' in request.resource.data);
      }

      // createdAt is stamped once — never rewrite it to game "New on RepChamp".
      function createdAtPinned() {
        return !('createdAt' in resource.data)
          || request.resource.data.createdAt == resource.data.createdAt;
      }

      // Multi-device sync: a slower device must not lower lifetime XP.
      function totalXpMonotonic() {
        return !('totalXp' in resource.data)
          || request.resource.data.totalXp >= resource.data.totalXp;
      }

      allow create: if isOwner(uid) && isProfileWrite();
      allow update: if isOwner(uid) && (
        isPresenceOnly()
        || isLegacyPushStrip()
        || (isProfileWrite() && createdAtPinned() && totalXpMonotonic())
      );
      allow delete: if isOwner(uid);

      // Owner-only secrets (Expo push token). Partners receive the token via the
      // couple member object the owner writes while paired — never via this path.
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /friends/{friendUid} {
        // Only the list owner may add/remove. Reciprocal friendship requires the
        // other athlete to add you back (no force-inject onto someone else's list).
        allow read, create, update, delete: if isOwner(uid);
      }

      // Owner-managed block list — used to hide peers and refuse invites.
      match /blocks/{blockedUid} {
        allow read, create, update, delete: if isOwner(uid);
      }
    }

    // User reports — create-only for the reporter; no client list/read (review
    // happens in console / support). Caps keep spam payloads small.
    match /reports/{reportId} {
      allow create: if isAuthed()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['reporterUid', 'targetUid', 'reason', 'note', 'context',
              'createdAt', 'clientAt'])
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() <= 128
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 40
        // Mirrors REPORT_REASONS in domain/safety.ts.
        && request.resource.data.reason in
             ['inappropriate_avatar', 'harassment', 'spam', 'impersonation', 'other']
        // Server-stamped when present, so a report cannot be back-dated.
        && (!('createdAt' in request.resource.data)
            || request.resource.data.createdAt == request.time)
        && (!('clientAt' in request.resource.data)
            || request.resource.data.clientAt is number)
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string
                && request.resource.data.note.size() <= 400))
        && (!('context' in request.resource.data)
            || (request.resource.data.context is string
                && request.resource.data.context.size() <= 80));
      allow read, update, delete: if false;
    }

    match /duels/{duelId} {
      function isPlayer() {
        return isAuthed() &&
          (request.auth.uid == resource.data.hostUid ||
           request.auth.uid == resource.data.guestUid);
      }

      function isTarget() {
        return isAuthed() && request.auth.uid == resource.data.targetUid;
      }

      // An open QR invite is published on purpose: the host is showing the
      // code to whoever is standing in front of them, and the scanner has to
      // read the duel before `joinDuel` can seat them. Narrow on purpose —
      // it lapses the moment someone joins, because taking the guest seat
      // flips `status` to 'active' and this clause stops matching.
      //
      // Kept in step with `isJoinableByQr` in domain/duelInvite.ts, which is
      // what the client checks so it can explain "someone already joined"
      // rather than surfacing a bare permission error.
      function isOpenInvite() {
        return isAuthed()
          && resource.data.status == 'pending'
          && resource.data.targetUid == null
          && resource.data.guestUid == null;
      }

      // `resource == null` first, for the reason spelled out on couples below:
      // every other clause dereferences `resource`, so a get on a duel that
      // has been deleted threw and surfaced as PERMISSION_DENIED instead of
      // "not found" — which also failed the queue transactions that follow a
      // stale `matched` ticket to its duel. A missing document returns no data.
      //
      // The open-invite clause is get-only. As a `read` it also answered list
      // queries, so any signed-in client could enumerate every open QR lobby
      // and take the seat without ever being shown the code.
      allow get: if isAuthed()
        && (resource == null || isPlayer() || isTarget() || isOpenInvite());
      allow list: if isPlayer() || isTarget();

      // Host opens a pending invite, or a matchmaking seeker mints an active
      // duel where they are the guest and both seats start at zero reps.
      // A seat is the eight fields `makePlayer` writes (plus the optional
      // `photoUrl`). Capped because both players download the whole document
      // on every live tick — an uncapped seat was room for ~1 MiB of anything.
      function seatShapeOk(s) {
        return s.keys().hasOnly(['uid', 'displayName', 'avatarUrl', 'photoUrl',
                                 'level', 'reps', 'formScore', 'done', 'forfeited'])
          && s.displayName is string
          && s.displayName.size() <= 200
          && smallUrl(s, 'avatarUrl')
          && smallUrl(s, 'photoUrl');
      }

      // Every new duel, whichever way it is opened: known keys only, a real
      // format, no winner yet, and a host seat that has not started.
      function duelShapeOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['id', 'exercise', 'duration', 'status', 'hostUid',
                                 'guestUid', 'targetUid', 'host', 'guest', 'winnerUid',
                                 'cooperative', 'kind', 'createdAt', 'startedAt'])
          && d.exercise is string
          && d.exercise.size() <= 40
          && d.duration is number
          && d.duration > 0
          && d.duration <= 3600
          && d.get('winnerUid', null) == null
          && seatShapeOk(d.host)
          && d.host.done == false;
      }

      allow create: if isAuthed()
        && duelShapeOk()
        && (
          (request.resource.data.hostUid == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.guestUid == null
            && request.resource.data.get('guest', null) == null
            && request.resource.data.host.uid == request.auth.uid
            && request.resource.data.host.reps == 0
            && (!('kind' in request.resource.data)
                || request.resource.data.kind in ['duel', 'train', 'compete'])
            && (request.resource.data.targetUid == null
                || (request.resource.data.targetUid is string
                    && request.resource.data.targetUid != request.auth.uid
                    && request.resource.data.targetUid.size() <= 128)))
          ||
          (request.resource.data.status == 'active'
            && request.resource.data.targetUid == null
            && request.resource.data.guestUid == request.auth.uid
            && request.resource.data.hostUid is string
            && request.resource.data.hostUid != request.auth.uid
            && request.resource.data.host.uid == request.resource.data.hostUid
            && request.resource.data.guest.uid == request.auth.uid
            && request.resource.data.host.reps == 0
            && request.resource.data.guest.reps == 0
            && seatShapeOk(request.resource.data.guest)
            && request.resource.data.guest.done == false
            // The forfeit clock runs from here, so it has to be the server's.
            && request.resource.data.startedAt == request.time
            // The named host must actually be in the queue. `get` reads the
            // ticket as it stood before this commit — still `waiting`, since
            // `tryPair` flips it in the same transaction. Without this anyone
            // could seat any athlete as the host of a live duel they never
            // asked for and could not delete.
            && get(/databases/$(database)/documents/matchmaking/$(request.resource.data.hostUid))
                 .data.status == 'waiting')
        );

      function isJoin() {
        return resource.data.status == 'pending'
          && resource.data.guestUid == null
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.status == 'active'
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.host.uid == resource.data.host.uid
          && request.resource.data.guest.uid == request.auth.uid
          && request.resource.data.guest.reps == 0
          && (resource.data.targetUid == null || resource.data.targetUid == request.auth.uid)
          && request.resource.data.guest.done == false
          && seatShapeOk(request.resource.data.guest)
          // A join seats the guest and starts the clock, nothing else. Without
          // the cap the joiner could rewrite the host's seat, the format
          // (`duration`, `exercise`) or `winnerUid` in the same write.
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'guestUid', 'guest', 'startedAt'])
          // Server-stamped: `forfeitWindowOpen` measures from this.
          && request.resource.data.startedAt == request.time;
      }

      // Mirrors `resolveWinner` in src/domain/duel.ts: a lone forfeit loses,
      // otherwise more reps wins, and a tie is a draw (null). A together set
      // has no winner, so null is also accepted when `cooperative`.
      function winnerOk() {
        let h = request.resource.data.host;
        let g = request.resource.data.guest;
        let hf = h.get('forfeited', false) == true;
        let gf = g.get('forfeited', false) == true;
        let expected = (hf && !gf) ? g.uid
          : ((gf && !hf) ? h.uid
          : (h.reps > g.reps ? h.uid
          : (g.reps > h.reps ? g.uid : null)));
        let w = request.resource.data.get('winnerUid', null);
        return w == expected
          || (w == null && resource.data.get('cooperative', false) == true);
      }

      // `status` and `winnerUid` ride along on seat writes, and used to be
      // free: a player could declare themselves the winner mid-set, or flip a
      // live duel back to `pending` and then delete it. Now a seat write
      // either leaves both alone, or settles — and settling needs both seats
      // done and the winner the scores actually produce.
      function settleOk() {
        return (request.resource.data.host.done == true
                && request.resource.data.guest.done == true)
          ? (request.resource.data.status == 'finished' && winnerOk())
          : (request.resource.data.status == 'active'
              && request.resource.data.get('winnerUid', null)
                   == resource.data.get('winnerUid', null));
      }

      // Mirrors `canForfeitOpenOpponent` / ABANDON_SETTLE_GRACE_MS in
      // src/domain/duel.ts: an open seat may be forfeited only once the match
      // window plus 60s grace has passed. Documents with no `startedAt`
      // predate the stamp and stay settleable, as they are on the client.
      function forfeitWindowOpen() {
        return !('startedAt' in resource.data)
          || request.time >= resource.data.startedAt
               + duration.value(int(resource.data.duration) + 60, 's');
      }

      // Live / finish writes may only touch the caller's own seat map, plus
      // status/winnerUid when settling. The opponent's seat is frozen.
      function hostSeatWrite() {
        // A settled duel or an already-finished seat takes no more live writes:
        // the client used to read the document before every tick to check this.
        return request.auth.uid == resource.data.hostUid
          && resource.data.status == 'active'
          && resource.data.host.done != true
          && request.resource.data.host.uid == resource.data.host.uid
          && request.resource.data.guestUid == resource.data.guestUid
          && request.resource.data.hostUid == resource.data.hostUid
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['host'])
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['host', 'status', 'winnerUid'])
          )
          && (resource.data.guest == null
              || request.resource.data.guest == resource.data.guest)
          && seatRepsFair(resource.data.host, request.resource.data.host)
          && seatShapeOk(request.resource.data.host)
          && settleOk();
      }

      function guestSeatWrite() {
        return request.auth.uid == resource.data.guestUid
          && resource.data.status == 'active'
          && resource.data.guest.done != true
          && resource.data.guest != null
          && request.resource.data.guest.uid == resource.data.guest.uid
          && request.resource.data.guestUid == resource.data.guestUid
          && request.resource.data.hostUid == resource.data.hostUid
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest'])
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['guest', 'status', 'winnerUid'])
          )
          && request.resource.data.host == resource.data.host
          && seatRepsFair(resource.data.guest, request.resource.data.guest)
          && seatShapeOk(request.resource.data.guest)
          && settleOk();
      }

      // Anti-cheat: reps non-decreasing + capped. Live ticks limited to +8;
      // finishing (`done: true`) may write the final score in one shot so a
      // missed live sync cannot brick settlement.
      function seatRepsFair(before, after) {
        return after.reps is number
          && after.reps >= 0
          && after.reps <= 500
          && after.reps >= before.reps
          && (
            after.done == true
              || after.reps <= before.reps + 8
          )
          && (!('formScore' in after)
              || (after.formScore is number
                  && after.formScore >= 0
                  && after.formScore <= 100));
      }

      // Opponent disconnect: caller may forfeit the *other* open seat at its
      // last synced reps (reps/uid/form frozen) and finish the duel. Own seat
      // may finish in the same write via seatRepsFair.
      function seatForfeitOnly(before, after) {
        return before != null
          && before.done == false
          && after.done == true
          && after.forfeited == true
          // Nothing else on the abandoned seat moves — not its score, and not
          // its name or avatar either.
          && after.diff(before).affectedKeys().hasOnly(['done', 'forfeited']);
      }

      function hostAbandonSettle() {
        return request.auth.uid == resource.data.hostUid
          && resource.data.status == 'active'
          && resource.data.guest != null
          && seatForfeitOnly(resource.data.guest, request.resource.data.guest)
          && request.resource.data.host.done == true
          && seatRepsFair(resource.data.host, request.resource.data.host)
          && seatShapeOk(request.resource.data.host)
          && request.resource.data.status == 'finished'
          && forfeitWindowOpen()
          && winnerOk()
          && request.resource.data.guestUid == resource.data.guestUid
          && request.resource.data.hostUid == resource.data.hostUid
          && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['guest', 'status', 'winnerUid'])
            || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['host', 'guest', 'status', 'winnerUid'])
          );
      }

      function guestAbandonSettle() {
        return request.auth.uid == resource.data.guestUid
          && resource.data.status == 'active'
          && resource.data.guest != null
          && seatForfeitOnly(resource.data.host, request.resource.data.host)
          && request.resource.data.guest.done == true
          && seatRepsFair(resource.data.guest, request.resource.data.guest)
          && seatShapeOk(request.resource.data.guest)
          && request.resource.data.status == 'finished'
          && forfeitWindowOpen()
          && winnerOk()
          && request.resource.data.guestUid == resource.data.guestUid
          && request.resource.data.hostUid == resource.data.hostUid
          && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['host', 'status', 'winnerUid'])
            || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['host', 'guest', 'status', 'winnerUid'])
          );
      }

      function isLiveUpdate() {
        return isPlayer() && (
          hostSeatWrite()
          || guestSeatWrite()
          || hostAbandonSettle()
          || guestAbandonSettle()
        );
      }

      allow update: if isAuthed() && (isJoin() || isLiveUpdate());

      // A live or settled match is shared state: the host must not be able to
      // delete it mid-set or after losing, which would erase the guest's
      // result. Hosts may withdraw only a still-pending invite; a target may
      // decline one that nobody has joined. Once a duel is `finished` either
      // player may remove it, which is what lets account deletion erase the
      // athlete's match history (their name and score live on that document).
      allow delete: if isAuthed() && (
        (resource.data.status == 'pending'
          && (resource.data.hostUid == request.auth.uid
              || (resource.data.targetUid == request.auth.uid
                  && resource.data.guestUid == null)))
        || (resource.data.status == 'finished'
            && (resource.data.hostUid == request.auth.uid
                || resource.data.guestUid == request.auth.uid))
      );
    }

    match /couples/{coupleId} {
      function isMember() {
        return isAuthed() && request.auth.uid in resource.data.memberUids;
      }

      // Get: members always; pending invites readable by code so a partner can join.
      // List: only docs where the caller is already a member (my-couples query).
      //
      // `resource == null` first, and not merely for tidiness: `createCouple`
      // opens its transaction with `tx.get(ref)` on a freshly minted pair code,
      // a document that by definition does not exist yet. Without this branch
      // both conditions below dereference a null `resource` and the rule throws
      //     Null value error  @ L333
      // so the read is denied and creation fails before it ever attempts a
      // write — surfacing to the athlete as
      //     [firestore/unknown] PERMISSION_DENIED
      // which reads like a write-permission problem and is not one.
      //
      // Allowing the read of a missing document leaks nothing: there is no data
      // to return, and `allow create` below still decides whether anything may
      // be written there.
      allow get: if isAuthed() && (
        resource == null
        || request.auth.uid in resource.data.memberUids
        || resource.data.pending == true
      );
      allow list: if isAuthed() && request.auth.uid in resource.data.memberUids;

      // A fresh seat has trained nothing and logged nothing. `daily` must be
      // absent rather than zeroed: `makeMember` does not write the field at
      // all, and "absent" is both what the client produces and the simpler
      // thing to enforce. Without this a joiner could seat themselves with a
      // fabricated water total — and, when steps land in the same object,
      // with a fabricated step count too.
      function memberZeroed(m) {
        return m.totalReps == 0
          && m.trainedDays.size() == 0
          && !('daily' in m)
          && m.uid is string
          && m.displayName is string;
      }

      // The member slice is the fields `CoupleMember` declares and no others,
      // with the free-text ones bounded: the partner downloads this slice on
      // every snapshot, and the document's 1 MiB is shared between the two.
      function memberShapeOk(m) {
        return m.keys().hasOnly(['uid', 'displayName', 'avatarUrl', 'trainedDays',
                                 'totalReps', 'expoPushToken', 'widgetPush',
                                 'creditedIds', 'daily', 'ritualPlan'])
          && m.displayName is string
          && m.displayName.size() <= 200
          && smallUrl(m, 'avatarUrl')
          && m.trainedDays is list
          && m.trainedDays.size() <= 5000
          && (!('creditedIds' in m)
              || (m.creditedIds is list && m.creditedIds.size() <= 250))
          && (m.get('expoPushToken', null) == null
              || (m.expoPushToken is string && m.expoPushToken.size() <= 200));
      }

      // The caller's own slice in the incoming document.
      function ownMemberShapeOk() {
        return request.resource.data.members[0].uid == request.auth.uid
          ? memberShapeOk(request.resource.data.members[0])
          : memberShapeOk(request.resource.data.members[1]);
      }

      // Creator seats only themselves at zero reps.
      allow create: if isAuthed()
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.pending == true
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0].uid == request.auth.uid
        && memberZeroed(request.resource.data.members[0])
        && memberShapeOk(request.resource.data.members[0])
        && request.resource.data.keys().hasOnly(
             ['id', 'memberUids', 'members', 'pending', 'createdAt']);

      // Joiner appends themselves at zero; the existing member's stats are frozen.
      //
      // The key set is capped as well as the values. Without `hasOnly` this rule
      // validated the member entries but let the joiner write *any* other
      // top-level field on someone else's document in the same operation —
      // including rewriting `createdAt`, which orders the doc. A join touches
      // exactly these four keys; `createdAt` is stamped once at create and pinned
      // here the same way `createdAtPinned()` pins it on user profiles.
      function isJoin() {
        return isAuthed()
          && resource.data.memberUids.size() == 1
          && request.resource.data.memberUids
               == resource.data.memberUids.concat([request.auth.uid])
          && request.resource.data.pending == false
          && request.resource.data.members.size() == 2
          && request.resource.data.members[0] == resource.data.members[0]
          && request.resource.data.members[1].uid == request.auth.uid
          && memberZeroed(request.resource.data.members[1])
          && memberShapeOk(request.resource.data.members[1])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberUids', 'members', 'pending', 'pairedAt'])
          && (!('createdAt' in resource.data)
              || request.resource.data.createdAt == resource.data.createdAt);
      }

      function memberUidsPinned() {
        return request.resource.data.members.size() == resource.data.members.size()
          && request.resource.data.members[0].uid == resource.data.members[0].uid
          && (resource.data.members.size() < 2
              || request.resource.data.members[1].uid == resource.data.members[1].uid);
      }

      function repsInSaneRange() {
        return request.resource.data.members[0].totalReps is number
          && request.resource.data.members[0].totalReps >= 0
          && request.resource.data.members[0].totalReps <= 10000000
          && (resource.data.members.size() < 2
              || (request.resource.data.members[1].totalReps is number
                  && request.resource.data.members[1].totalReps >= 0
                  && request.resource.data.members[1].totalReps <= 10000000));
      }

      // The set-to-value daily metrics (water now, steps later) must be a sane
      // number attached to a real day key, or absent entirely.
      //
      // The day is required because it is the only thing that makes a stale
      // total detectable: without it a phone that last synced yesterday would
      // have its number read as today's forever. The 20000 ceiling is
      // MAX_DAILY_ML in `src/domain/hydration.ts` — rules cannot import it, so
      // `firestore-rules/couples.test.ts` asserts the two agree.
      function dailySane(m) {
        return !('daily' in m)
          || (m.daily.day is string
              && m.daily.day.size() == 10
              && (!('waterMl' in m.daily)
                  || (m.daily.waterMl is number
                      && m.daily.waterMl >= 0
                      && m.daily.waterMl <= 20000))
              && (!('steps' in m.daily)
                  || (m.daily.steps is number
                      && m.daily.steps >= 0
                      && m.daily.steps <= 200000))
              // Today, together: the ritual ticks, the "here" heartbeat and a
              // live poke. Bounded so a modified client cannot park a huge
              // list or a paragraph on the partner's screen. 12 leaves room
              // for chosen habits (MAX_TICKS in src/domain/ritual.ts).
              && (!('habits' in m.daily)
                  || (m.daily.habits is list && m.daily.habits.size() <= 12))
              && (!('hereAt' in m.daily) || m.daily.hereAt is number)
              && (!('poke' in m.daily)
                  || (m.daily.poke is map
                      && m.daily.poke.keys().hasOnly(['e', 'at'])
                      && m.daily.poke.e is string
                      && m.daily.poke.e.size() <= 8
                      && m.daily.poke.at is number)));
      }

      // The couple's chosen ritual on a member's slice: three picks, a walk
      // goal and a time — bounded like the daily fields.
      function planSane(m) {
        return !('ritualPlan' in m)
          || (m.ritualPlan is map
              && m.ritualPlan.keys().hasOnly(['picks', 'walkGoal', 'at'])
              && m.ritualPlan.picks is list
              && m.ritualPlan.picks.size() <= 3
              && m.ritualPlan.walkGoal is number
              && m.ritualPlan.walkGoal >= 1000
              && m.ritualPlan.walkGoal <= 30000
              && m.ritualPlan.at is number);
      }

      function dailyInSaneRange() {
        return dailySane(request.resource.data.members[0])
          && planSane(request.resource.data.members[0])
          && (resource.data.members.size() < 2
              || (dailySane(request.resource.data.members[1])
                  && planSane(request.resource.data.members[1])));
      }

      // Each athlete may only mutate their own member slice (reps / days / push).
      // The partner's entire member map stays frozen (including their push token).
      //
      // The single-member branch used to read
      //   request.resource.data.members[0].uid == resource.data.members[0].uid
      // on both sides of a uid comparison that the line above had already made,
      // so it asserted nothing the caller could fail — a guard that looked like
      // it pinned the slice but did not. `isMember()` still kept strangers out,
      // so nothing was exploitable through it; it was simply dead. Pin the uid
      // to the *caller* instead, which is the invariant the two-member branch
      // below actually enforces.
      function onlyOwnMemberStatsChanged() {
        return (
          (resource.data.members.size() == 1
            && request.auth.uid == resource.data.members[0].uid
            && request.resource.data.members[0].uid == request.auth.uid)
          ||
          (resource.data.members.size() == 2
            && (
              (request.auth.uid == resource.data.members[0].uid
                && request.resource.data.members[1] == resource.data.members[1])
              ||
              (request.auth.uid == resource.data.members[1].uid
                && request.resource.data.members[0] == resource.data.members[0])
            ))
        );
      }

      // A nudge is a small fixed shape (see `Couple.nudge`). Without bounds a
      // member could park an arbitrarily large payload on the shared document,
      // which both partners download on every snapshot. `fromUid` is not pinned
      // to the caller: a whole-document merge legitimately re-sends the
      // partner's existing nudge unchanged.
      function nudgeSane() {
        let n = request.resource.data.get('nudge', null);
        return n == null
          || (n is map
              && n.keys().hasOnly(['fromUid', 'kind', 'ml', 'drink', 'emoji', 'milestone', 'at'])
              && (!('fromUid' in n) || (n.fromUid is string && n.fromUid.size() <= 128))
              && (!('kind' in n) || (n.kind is string && n.kind.size() <= 24))
              && (!('drink' in n) || (n.drink is string && n.drink.size() <= 24))
              && (!('emoji' in n) || (n.emoji is string && n.emoji.size() <= 16))
              && (!('milestone' in n) || n.milestone in ['half', 'goal'])
              && (!('at' in n) || n.at is timestamp || n.at is number)
              && (!('ml' in n) || (n.ml is number && n.ml >= 0 && n.ml <= 20000)));
      }

      function isNudgeOnly() {
        return isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nudge'])
          && nudgeSane();
      }

      // `pending` and `pairedAt` belong to the join alone. While a member
      // update could move them, either partner could flip a paired couple
      // back to `pending: true` — and a pending couple is readable by anyone
      // holding the code, push tokens included.
      function isMemberUpdate() {
        return isMember()
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members', 'nudge'])
          && memberUidsPinned()
          && repsInSaneRange()
          && dailyInSaneRange()
          && nudgeSane()
          && ownMemberShapeOk()
          && onlyOwnMemberStatsChanged();
      }

      allow update: if isJoin() || isNudgeOnly() || isMemberUpdate();
      allow delete: if isMember();
    }

    match /matchmaking/{ticketUid} {
      allow read: if isAuthed();
      // An athlete's own ticket is the shape `makeTicket` + `ttlFields` write.
      // It was unvalidated, and the whole queue is readable by every client.
      function ownTicketOk() {
        let t = request.resource.data;
        return t.keys().hasOnly(['uid', 'displayName', 'avatarUrl', 'level', 'exercise',
                                 'duration', 'status', 'duelId', 'expiresAt',
                                 'expiresAtTs', 'enqueuedAt'])
          && t.uid == ticketUid
          && t.displayName is string
          && t.displayName.size() <= 200
          && smallUrl(t, 'avatarUrl')
          && t.status in ['waiting', 'matched', 'cancelled'];
      }

      allow create, update: if isOwner(ticketUid) && ownTicketOk();
      allow delete: if isOwner(ticketUid);

      // A *foreign* claimer may flip someone's waiting ticket to `matched`, and
      // may move nothing else: `tryPair` writes exactly status + duelId on the
      // ticket it claims. The expiry pair is pinned along with the identity
      // fields because it decides both when the TTL service collects the ticket
      // and whether `canPair` still considers it live — left free, a claimer
      // could keep a rival's ticket alive indefinitely or expire it on the spot.
      allow update: if isAuthed()
        && request.auth.uid != ticketUid
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'matched'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.level == resource.data.level
        && (!('expiresAt' in resource.data)
            || request.resource.data.expiresAt == resource.data.expiresAt)
        && (!('expiresAtTs' in resource.data)
            || request.resource.data.expiresAtTs == resource.data.expiresAtTs)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'duelId'])
        && request.resource.data.duelId is string
        // `getAfter`, not `get`: `tryPair` mints the duel in the same
        // transaction as this claim, and `get`/`exists` only see what was
        // committed before it — so the duel never existed yet and every real
        // pairing was refused. A claim naming a duel that does not exist still
        // fails: there is no `.data` to read.
        && existsAfter(/databases/$(database)/documents/duels/$(request.resource.data.duelId))
        && getAfter(/databases/$(database)/documents/duels/$(request.resource.data.duelId)).data.hostUid
             == resource.data.uid
        && getAfter(/databases/$(database)/documents/duels/$(request.resource.data.duelId)).data.guestUid
             == request.auth.uid
        && getAfter(/databases/$(database)/documents/duels/$(request.resource.data.duelId)).data.status
             == 'active';
    }

    match /leaderboard/{uid} {
      allow read: if isAuthed();
      function validScoreRow() {
        return request.resource.data.uid == uid
          && request.resource.data.weeklyXp is number
          && request.resource.data.weeklyXp >= 0
          && request.resource.data.weeklyXp <= 50000
          && request.resource.data.totalXp is number
          && request.resource.data.totalXp >= 0
          && request.resource.data.totalXp <= 100000000
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 40
          && smallUrl(request.resource.data, 'avatarUrl')
          // `weekKey` was previously unvalidated, which made scoreMonotonic()
          // trivially bypassable: that check waives the "weeklyXp can only go
          // up" guard whenever the key differs, so any junk value disabled it.
          // Pin it to the ISO shape the client actually writes (2026-W31).
          && request.resource.data.weekKey is string
          && request.resource.data.weekKey.matches('^[0-9]{4}-W[0-9]{2}$');
      }
      // Same-week weeklyXp and lifetime totalXp are monotonic so a reinstall
      // with empty local sessions cannot wipe a real board row.
      function scoreMonotonic() {
        return (resource.data.weekKey != request.resource.data.weekKey
            || request.resource.data.weeklyXp >= resource.data.weeklyXp)
          && request.resource.data.totalXp >= resource.data.totalXp;
      }
      allow create: if isOwner(uid) && validScoreRow();
      allow update: if isOwner(uid) && validScoreRow() && scoreMonotonic();
      allow delete: if isOwner(uid);
    }
  }
}
