rules_version = '2';

// RepChamp Cloud Storage rules — avatar images only.
// Each athlete may read/write only their own avatar object; avatars are
// world-readable so friends and the leaderboard can display them.

service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}.jpg {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024   // 5 MB cap
        && request.resource.contentType.matches('image/.*');
    }
  }
}
