rules_version = '2';

// RepChamp Cloud Storage rules — avatar images and duel/together action shots.
// Writes: owner + size/type caps (JPEG/PNG/WebP). Reads: signed-in athletes.

service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024   // 2 MB
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Action shots from the removed duel/together photo-share feature.
    //
    // Writes are gone: nothing in the app uploads here any more. Delete is
    // deliberately kept so `deleteAccount` can still erase photos uploaded
    // while the feature was live — those are real photographs of real
    // athletes, and the deletion promise has to keep covering them.
    // Read stays for the same reason (delete-after-resolve paths).
    match /duelPhotos/{duelId}/{seat}.jpg {
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if request.auth != null
        && seat in ['host', 'guest']
        && request.auth.uid == firestore.get(/databases/(default)/documents/duels/$(duelId)).data[seat].uid;
    }
  }
}
